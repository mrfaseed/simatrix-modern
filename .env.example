# ==========================================
# Simatrix Platform Environment Variables
# ==========================================

# Port for the public web application (Hostinger typically assigns this or defaults to 3000)
PORT=3000

# Port for internal Express backend API
BACKEND_PORT=5000

# Public URL of your hosted website on Hostinger (e.g. https://yourdomain.com)
NEXT_PUBLIC_APP_URL=http://localhost:3000
APP_URL=http://localhost:3000

# Backend URL used by Next.js server components/routes
BACKEND_URL=http://127.0.0.1:5000

# Production environment
NODE_ENV=production
